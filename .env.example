# ============================================================
# Project 1: ClaimSense – Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit the actual .env file to version control.
# ============================================================

# ── Azure OpenAI ─────────────────────────────────────────────
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# ── Azure Storage ─────────────────────────────────────────────
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...
AZURE_STORAGE_CONTAINER_NAME=claimsense-docs

# ── Azure Key Vault ───────────────────────────────────────────
AZURE_KEYVAULT_URL=https://your-keyvault.vault.azure.net/
AZURE_CLIENT_ID=your_service_principal_client_id
AZURE_CLIENT_SECRET=your_service_principal_client_secret
AZURE_TENANT_ID=your_azure_tenant_id

# ── PostgreSQL / Azure SQL ────────────────────────────────────
DATABASE_URL=postgresql://username:password@localhost:5432/claimsense_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=claimsense_db
DB_USER=claimsense_user
DB_PASSWORD=your_db_password_here

# ── MLflow ────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=claimsense-fraud-classifier

# ── Vector Database ───────────────────────────────────────────
VECTOR_DB_TYPE=faiss
# For ChromaDB (optional)
CHROMA_HOST=localhost
CHROMA_PORT=8000

# ── FastAPI ───────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8080
SECRET_KEY=your_secret_key_change_this_in_production
DEBUG=True

# ── Streamlit ─────────────────────────────────────────────────
STREAMLIT_PORT=8501

# ── Embedding Model ───────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── App Settings ──────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
